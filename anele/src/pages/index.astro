---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import WorkGrid from "@components/WorkGrid.astro";
import CTASection from "@components/CTASection.astro";
import HeroMotif from "@components/HeroMotif.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((item) => item.data.featured).slice(0, 3);
const heroPiece = featured[0];
---

<BaseLayout
  title="Anele Pama — Artist & Graphic Designer"
  description="Portfolio of Anele Pama — artist and graphic designer in Cape Town. Art, branding, illustration, layout, and visual design through Aceart Graphics."
>
  <section class="page-shell reveal-section py-16 sm:py-24">
    <div class="relative grid items-center gap-12 overflow-hidden lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <HeroMotif class="absolute -right-8 top-8 hidden w-72 opacity-40 lg:block xl:w-96" />
      <div class="relative z-10">
        <p class="eyebrow">Aceart Graphics</p>
        <h1 class="display-heading mt-4">Anele Pama</h1>
        <p class="mt-4 text-lg font-semibold text-ink/80 sm:text-xl">Artist &amp; Graphic Designer, Cape Town</p>
        <p class="body-copy mt-6 max-w-xl">
          Based in Cape Town, Anele works across illustration, typography, layout design, painting, and photography.
          With a diploma in Visual Communication from CPUT, he brings a detail-led approach to both personal artwork and
          client-facing design.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/work/" class="button-primary">View Selected Work</a>
          <a href="/about/" class="button-secondary">About Anele</a>
        </div>
      </div>
      {
        heroPiece && (
          <figure class="relative z-10 bg-bone shadow-gallery">
            <img
              src={heroPiece.data.cover}
              alt={heroPiece.data.coverAlt}
              width="1200"
              height="1500"
              class="aspect-[4/5] w-full object-cover"
            />
          </figure>
        )
      }
    </div>
  </section>

  <section class="page-shell reveal-section py-12 sm:py-20">
    <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">Selected Work</p>
        <h2 class="section-heading mt-4">Featured pieces</h2>
      </div>
      <a href="/work/" class="button-secondary self-start sm:self-auto">All Work</a>
    </div>
    <WorkGrid items={featured} />
  </section>

  <section class="page-shell reveal-section py-12 sm:py-20">
    <div class="grid gap-6 md:grid-cols-3">
      <a href="/work/#art" class="border-y border-ink/10 py-10 transition hover:border-rust">
        <p class="eyebrow">01</p>
        <h3 class="mt-4 font-display text-4xl font-semibold">Art</h3>
        <p class="mt-4 text-sm leading-7 text-ink/65">Painting, drawing, mixed media, and personal visual studies.</p>
      </a>
      <a href="/work/#graphic-design" class="border-y border-ink/10 py-10 transition hover:border-rust">
        <p class="eyebrow">02</p>
        <h3 class="mt-4 font-display text-4xl font-semibold">Graphic Design</h3>
        <p class="mt-4 text-sm leading-7 text-ink/65">Branding, editorial layouts, posters, flyers, and visual systems.</p>
      </a>
      <a href="/contact/" class="border-y border-ink/10 py-10 transition hover:border-rust">
        <p class="eyebrow">03</p>
        <h3 class="mt-4 font-display text-4xl font-semibold">Enquiries</h3>
        <p class="mt-4 text-sm leading-7 text-ink/65">Commissions, collaborations, and design projects.</p>
      </a>
    </div>
  </section>

  <section class="page-shell reveal-section py-12 sm:py-20">
    <blockquote class="mx-auto max-w-4xl text-center font-display text-4xl font-semibold leading-tight text-ink/55 sm:text-5xl">
      "Whether crafting visuals for brands, bringing ideas to life through illustration, or capturing a moment through
      photography, the work is driven by creativity, detail, and a pursuit of excellence."
    </blockquote>
  </section>

  <CTASection />
</BaseLayout>
