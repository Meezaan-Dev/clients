---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink/10 bg-ink text-white">
  <div class="page-shell grid gap-10 py-14 md:grid-cols-[1fr_auto] md:items-center">
    <div>
      <p class="font-display text-4xl font-semibold">Anele Pama</p>
      <p class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-white/50">Aceart Graphics</p>
      <p class="mt-3 max-w-xl text-sm leading-7 text-white/70">
        Artist and graphic designer in Cape Town — illustration, typography, layout, painting, photography, and brand
        visuals.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        class="border border-white/20 px-4 py-3 text-sm font-semibold transition hover:border-white hover:bg-white hover:text-ink"
        href="/contact/">Contact</a
      >
      <a
        class="border border-white/20 px-4 py-3 text-sm font-semibold transition hover:border-white hover:bg-white hover:text-ink"
        href="/work/">View Work</a
      >
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="page-shell flex flex-col gap-3 py-6 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>Copyright © {year} Anele Pama · Aceart Graphics</p>
      <a class="transition hover:text-white" href="mailto:pamaanele7@gmail.com">pamaanele7@gmail.com</a>
    </div>
  </div>
</footer>
