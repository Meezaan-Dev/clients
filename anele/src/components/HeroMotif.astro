---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["pointer-events-none select-none", className]} aria-hidden="true">
  <svg
    viewBox="0 0 480 320"
    class="h-full w-full max-w-md opacity-90"
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle cx="120" cy="200" r="110" fill="#6b7c4e" />
    <circle cx="240" cy="160" r="130" fill="#e07a62" />
    <circle cx="360" cy="200" r="100" fill="#ae633f" />
    <circle cx="180" cy="120" r="85" fill="#2d4a3e" />
    <circle cx="300" cy="240" r="75" fill="#f7f5ee" fill-opacity="0.35" />
  </svg>
</div>
