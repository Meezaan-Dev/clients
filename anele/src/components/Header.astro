---
const navItems = [
  { href: "/", label: "Home", match: (path: string) => path === "/" },
  { href: "/work/", label: "Work", match: (path: string) => path.startsWith("/work") },
  { href: "/about/", label: "About", match: (path: string) => path.startsWith("/about") },
  { href: "/contact/", label: "Contact", match: (path: string) => path.startsWith("/contact") },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/95 backdrop-blur-sm">
  <div class="page-shell flex min-h-[4.5rem] items-center justify-between gap-4 sm:min-h-24 sm:gap-6">
    <a href="/" class="group border-2 border-ink px-3 py-2 sm:px-4">
      <span class="block font-display text-xl font-bold leading-none tracking-wide sm:text-2xl">Anele Pama</span>
      <span class="mt-1 block text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-ink/55 group-hover:text-rust sm:text-xs">
        Aceart Graphics
      </span>
    </a>
    <nav aria-label="Primary navigation" class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => (
          <a
            class:list={[
              "text-sm font-semibold transition hover:text-rust",
              item.match(currentPath) ? "text-rust" : "text-ink",
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href="/contact/" class="button-primary hidden md:inline-flex">Enquire</a>
    <button
      type="button"
      class="nav-toggle inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-sm border border-ink/15 text-ink transition hover:border-rust hover:text-rust md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <svg class="h-5 w-5 nav-icon-open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="hidden h-5 w-5 nav-icon-close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-nav"
  class="mobile-nav fixed inset-0 z-50 flex translate-x-full flex-col bg-paper transition-transform duration-300 ease-out md:hidden"
  aria-hidden="true"
  inert
>
  <div class="page-shell flex min-h-[4.5rem] items-center justify-end border-b border-ink/10">
    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-ink/15 text-ink transition hover:border-rust hover:text-rust"
      aria-label="Close menu"
      data-nav-close
    >
      <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <nav aria-label="Mobile navigation" class="page-shell flex flex-1 flex-col justify-center py-10">
    {
      navItems.map((item) => (
        <a
          class:list={[
            "mobile-nav-link border-b border-ink/10 py-5 font-display text-[clamp(2rem,8vw,2.5rem)] font-semibold leading-none transition active:text-rust",
            item.match(currentPath) ? "text-rust" : "text-ink hover:text-rust",
          ]}
          href={item.href}
          data-nav-link
        >
          {item.label}
        </a>
      ))
    }
    <a href="/contact/" class="button-primary mt-10 w-full justify-center py-4 text-base" data-nav-link>Enquire</a>
  </nav>
  <div class="page-shell border-t border-ink/10 py-8 text-center">
    <a class="text-sm font-semibold text-ink/70 transition hover:text-rust" href="mailto:pamaanele7@gmail.com" data-nav-link>
      pamaanele7@gmail.com
    </a>
    <p class="mt-2 text-xs font-semibold uppercase tracking-[0.18em] text-ink/45">Cape Town</p>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.getElementById("mobile-nav");
  const closeButtons = document.querySelectorAll<HTMLButtonElement>("[data-nav-close]");
  const links = document.querySelectorAll<HTMLElement>("[data-nav-link]");
  const iconOpen = toggle?.querySelector(".nav-icon-open");
  const iconClose = toggle?.querySelector(".nav-icon-close");

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    panel.setAttribute("aria-hidden", open ? "false" : "true");
    panel.classList.toggle("translate-x-full", !open);
    panel.classList.toggle("translate-x-0", open);
    if (open) {
      panel.removeAttribute("inert");
    } else {
      panel.setAttribute("inert", "");
    }
    document.body.classList.toggle("overflow-hidden", open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  function closeMenu() {
    setOpen(false);
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setOpen(!isOpen);
  });

  closeButtons.forEach((btn) => btn.addEventListener("click", closeMenu));
  links.forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle.focus();
    }
  });
</script>
