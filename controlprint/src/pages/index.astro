---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="text-center py-20 bg-gray-50">
    <h1 class="text-5xl font-bold mb-6">Welcome to Control Print</h1>
    <p class="text-lg text-gray-600 mb-8">High-quality printing and stationery solutions for your business.</p>
    <a href="/quote" class="bg-blue-900 text-white px-8 py-4 rounded hover:bg-blue-800 transition">Get a Quote</a>
  </section>

  <!-- Services Section -->
  <section class="py-20 grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
    <div class="p-6 border rounded shadow hover:shadow-lg transition">
      <h2 class="font-bold text-2xl mb-4">Business Cards</h2>
      <p>Professional, high-quality cards for your business.</p>
    </div>
    <div class="p-6 border rounded shadow hover:shadow-lg transition">
      <h2 class="font-bold text-2xl mb-4">Flyers & Posters</h2>
      <p>Custom printed flyers and posters that grab attention.</p>
    </div>
    <div class="p-6 border rounded shadow hover:shadow-lg transition">
      <h2 class="font-bold text-2xl mb-4">Laminating & Scanning</h2>
      <p>Protect and digitize your documents with ease.</p>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="text-center py-20 bg-blue-900 text-white">
    <h2 class="text-3xl font-bold mb-4">Ready to start your print project?</h2>
    <a href="/quote" class="bg-white text-blue-900 px-8 py-4 rounded hover:bg-gray-100 transition">Get a Quote Today</a>
  </section>
</Layout>
