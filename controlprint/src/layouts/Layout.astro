---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/dist/global.css" />
  </head>
  <body class="font-sans text-gray-800">
    <header class="bg-blue-900 text-white">
      <nav class="container mx-auto flex justify-between items-center p-4">
        <a href="/" class="font-bold text-xl">ControlPrint</a>
        <ul class="flex space-x-6">
          <li><a href="/" class="hover:text-gray-200">Home</a></li>
          <li><a href="/gallery" class="hover:text-gray-200">Gallery</a></li>
          <li><a href="/specials" class="hover:text-gray-200">Specials</a></li>
          <li><a href="/contact" class="hover:text-gray-200">Contact</a></li>
          <li><a href="/quote" class="hover:text-gray-200">Get a Quote</a></li>
        </ul>
      </nav>
    </header>

    <main class="container mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="bg-gray-100 text-gray-700 text-center py-6 mt-12">
      <p>Tel: 021-706 8206 | Email: info@controlprint.co.za</p>
      <p>&copy; {new Date().getFullYear()} Control Print</p>
    </footer>
  </body>
</html>
