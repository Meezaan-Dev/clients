---
import BaseLayout from "@/layouts/BaseLayout.astro";
import site from "@/data/site.json";
import type { Product } from "@/types/product";

export function getStaticPaths() {
  return (site.products as Product[]).map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;

const product = (site.products as Product[]).find((p) => p.slug === slug);

if (!product) {
  throw new Error(`Product not found: ${slug}`);
}
---

<BaseLayout>
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-2 gap-12">
      <!-- Image -->
      <div class="bg-gray-100 rounded-lg p-6 flex items-center justify-center">
        <img
          src={product.image}
          alt={product.name}
          class="max-h-96 object-contain"
        />
      </div>

      <!-- Details -->
      <div>
        <h1 class="text-4xl font-bold tracking-tight">
          {product.name}
        </h1>

        <p class="mt-4 text-gray-600 leading-relaxed">
          {product.description}
        </p>

        <!-- <p class="mt-6 text-2xl font-semibold">
          R {product.price}
        </p> -->

        <div class="mt-8 flex gap-4">
          <button
            class="rounded-md bg-black px-6 py-3 text-white text-sm hover:bg-gray-800 transition"
          >
            Enquire Now
          </button>

          <a
            href="/products"
            class="rounded-md border px-6 py-3 text-sm hover:border-black transition"
          >
            Back to products
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
