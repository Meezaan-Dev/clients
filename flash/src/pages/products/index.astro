---
import BaseLayout from "@/layouts/BaseLayout.astro";
import site from "@/data/site.json";
import ProductGrid from "@/components/product/ProductGrid.astro";
---

<BaseLayout>
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <header class="mb-10">
        <h1 class="text-4xl font-bold tracking-tight">Products</h1>
        <p class="mt-2 text-gray-600 max-w-xl">
          Explore our range of reliable energy and power solutions, designed for
          homes and businesses.
        </p>
      </header>

      <ProductGrid products={site.products} />
    </div>
  </section>
</BaseLayout>
