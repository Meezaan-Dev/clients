---
import type { Product } from "@/types/product"

interface Props {
  product: Product
}

const { product } = Astro.props
---

<a
  href={`/products/${product.slug}`}
  class="rounded border p-4 hover:border-black transition"
>
  <img src={product.image} alt={product.name} class="h-40 w-full object-contain" />
  <h3 class="mt-4 font-semibold">{product.name}</h3>
  <!-- <p class="text-sm text-gray-600 mt-1">R {product.price}</p> -->
</a>
