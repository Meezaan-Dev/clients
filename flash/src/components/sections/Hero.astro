---
import site from "@/data/site.json"
---

<section class="bg-gray-50 py-20">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h1 class="text-4xl font-bold">{site.hero.title}</h1>
    <p class="mt-4 text-gray-600">{site.hero.subtitle}</p>
    <a
      href="/products"
      class="inline-block mt-6 rounded bg-black px-6 py-3 text-white text-sm"
    >
      {site.hero.cta}
    </a>
  </div>
</section>
