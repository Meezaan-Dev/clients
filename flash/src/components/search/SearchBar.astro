---
import { searchProducts } from "@/utils/search";
---

<form action="/products" class="flex-1 max-w-md">
  <input
    type="search"
    placeholder="Search products..."
    class="rounded border px-3 py-1 text-sm focus:outline-none focus:ring w-48"
    onfocus="document.getElementById('search-modal')?.classList.remove('hidden'); document.getElementById('search-input')?.focus();"
  />
</form>
