---
import site from "@/data/site.json";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";
---

<div class="fixed right-3 bottom-3 z-[70] flex flex-col items-end gap-3 sm:right-6 sm:bottom-6" data-whatsapp-widget>
  <div class="w-[min(360px,calc(100vw-2rem))] overflow-hidden rounded-lg border border-[#dce6eb] bg-white text-[#263746] shadow-[0_18px_48px_rgb(7_59_99/25%)]" id="whatsapp-panel" role="dialog" aria-labelledby="whatsapp-title" hidden data-whatsapp-panel>
    <div class="flex items-start justify-between gap-4 bg-[#128c7e] p-[1.15rem] text-white">
      <div class="flex items-center gap-3">
        <span class="grid h-[38px] w-[38px] shrink-0 place-items-center rounded-full bg-white text-[#128c7e]"><WhatsAppIcon class="h-5 w-5 shrink-0" /></span>
        <div>
          <strong class="block text-[1.05rem]" id="whatsapp-title">Chat with AK Comms</strong>
          <span class="mt-0.5 block text-[0.8rem] text-white/80">Typically the quickest way to enquire</span>
        </div>
      </div>
      <button class="grid h-[34px] w-[34px] shrink-0 cursor-pointer place-items-center rounded-sm border-0 bg-black/10 text-white focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan" type="button" aria-label="Close WhatsApp chat prompt" data-whatsapp-close>
        <svg class="w-[18px] fill-none stroke-current stroke-2 [stroke-linecap:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="p-[1.15rem]">
      <p class="m-0 rounded-sm bg-[#eef8f3] p-[0.9rem] text-[0.92rem] leading-[1.6]">Hello. How can we help with your connectivity, security or smart technology requirements?</p>
      <a class="mt-4 flex min-h-[46px] items-center justify-center gap-2 rounded-sm bg-[#25d366] text-[0.92rem] font-bold text-[#073b30] no-underline hover:bg-[#36df77] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon class="h-5 w-5 shrink-0" />
        Start WhatsApp chat
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <button
    class="inline-flex h-14 w-14 cursor-pointer items-center justify-center gap-3 rounded-full border-0 bg-[#25d366] p-0 text-[0.94rem] font-bold text-[#073b30] shadow-[0_8px_24px_rgb(7_59_99/24%)] hover:bg-[#36df77] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan sm:w-auto sm:px-[1.1rem] sm:py-3"
    type="button"
    aria-label="Open WhatsApp chat prompt"
    aria-expanded="false"
    aria-controls="whatsapp-panel"
    data-whatsapp-trigger
  >
    <span class="hidden sm:inline">Chat with us</span>
    <WhatsAppIcon class="h-7 w-7 shrink-0" />
  </button>
</div>

<script>
  const widget = document.querySelector("[data-whatsapp-widget]");
  const panel = widget?.querySelector("[data-whatsapp-panel]") as HTMLElement | null;
  const trigger = widget?.querySelector("[data-whatsapp-trigger]") as HTMLButtonElement | null;
  const closeButton = widget?.querySelector("[data-whatsapp-close]") as HTMLButtonElement | null;

  const closePanel = (returnFocus = true) => {
    if (!panel || !trigger) return;
    panel.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
    trigger.setAttribute("aria-label", "Open WhatsApp chat prompt");
    if (returnFocus) trigger.focus();
  };

  const openPanel = () => {
    if (!panel || !trigger) return;
    panel.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
    trigger.setAttribute("aria-label", "Hide WhatsApp chat prompt");
    closeButton?.focus();
  };

  trigger?.addEventListener("click", () => {
    if (panel?.hidden) openPanel();
    else closePanel(false);
  });

  closeButton?.addEventListener("click", () => closePanel());

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && panel && !panel.hidden) closePanel();
  });

  document.addEventListener("click", (event) => {
    if (panel?.hidden || widget?.contains(event.target as Node)) return;
    closePanel(false);
  });
</script>
