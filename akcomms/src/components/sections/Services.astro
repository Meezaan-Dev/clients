---
import site from "@/data/site.json";
import type { Service } from "@/types/site";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";

const services = site.services as Service[];
const revealClass = "transition-[opacity,transform] duration-[620ms] ease-[cubic-bezier(0.22,1,0.36,1)] [.motion-ready_&]:translate-y-[18px] [.motion-ready_&]:opacity-0 data-[visible=true]:!translate-y-0 data-[visible=true]:!opacity-100 motion-reduce:!translate-y-0 motion-reduce:!opacity-100 motion-reduce:!transition-none";
const delays = ["delay-0", "delay-75", "delay-150", "delay-200", "delay-200"];
---

<section id="services" class="relative border-t border-brand-navy/10 bg-white py-[4.25rem] sm:py-[4.5rem] xl:py-20">
  <div class="mx-auto w-[min(calc(100%_-_2.5rem),1140px)] sm:w-[min(calc(100%_-_3rem),900px)] lg:w-[min(calc(100%_-_3rem),1080px)] xl:w-[min(calc(100%_-_clamp(2rem,6vw,6rem)),1240px)] 2xl:w-[min(calc(100%_-_8rem),1320px)]">
    <div class:list={["mb-10 max-w-[680px] text-left sm:mx-auto sm:mb-12 sm:text-center", revealClass]} data-reveal>
      <p class="m-0 mb-3 text-sm font-bold tracking-[0.06em] text-brand-cyan-dark uppercase"><span class="mr-2 text-brand-navy tabular-nums">02</span> Our services</p>
      <h2 class="m-0 text-[1.9rem] leading-[1.22] font-bold tracking-[-0.02em] text-brand-navy sm:text-[clamp(2.15rem,3.1vw,2.85rem)] sm:leading-[1.35]">Services for better connectivity, control and security.</h2>
      <p class="mt-4 text-base leading-[1.7] text-brand-copy sm:text-[1.12rem] sm:leading-[1.75]">Installation, extension, relocation and repair services across the systems you depend on.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <article class:list={["relative rounded-sm border border-brand-navy/15 bg-white px-[1.4rem] py-[1.65rem] text-left transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-[3px] hover:border-brand-cyan/35 hover:shadow-[0_14px_32px_rgb(0_48_96/8%)] sm:px-6 sm:py-7", revealClass, delays[index]]} data-reveal>
          <div class="grid h-12 w-12 place-items-center text-brand-cyan">
            {service.key === "wifi" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5a12 12 0 0 1 16 0M7 13a7.5 7.5 0 0 1 10 0M10 16.5a3 3 0 0 1 4 0M12 20h.01" /></svg>}
            {service.key === "cctv" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 7 14-2 2 9-14 2-2-9Zm13 8 2 4M15 19h6M6 16l-2 3" /><circle cx="15.5" cy="9.5" r="2.5" /></svg>}
            {service.key === "fibre" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4v5a3 3 0 0 0 3 3h8a3 3 0 0 1 3 3v5M2 4h6M16 20h6" /><circle cx="12" cy="12" r="2" /></svg>}
            {service.key === "smart-home" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-7 9 7v9H3v-9Z" /><path d="M8 14a6 6 0 0 1 8 0M10.5 16.5a2.3 2.3 0 0 1 3 0M12 19h.01" /></svg>}
            {service.key === "equipment" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M7 9h.01M11 9h.01M15 9h2M7 14h10" /></svg>}
          </div>
          <h3 class="mt-4 mb-2 text-[1.18rem] leading-[1.3] font-bold text-brand-navy sm:text-[1.28rem]">{service.title}</h3>
          <p class="m-0 text-[0.96rem] leading-[1.7] text-brand-copy sm:text-base">{service.description}</p>
          <a class="mt-3 inline-flex items-center gap-1.5 text-[0.98rem] font-bold text-brand-cyan-dark no-underline hover:underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon class="h-4 w-4 shrink-0" />
            Enquire now
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
