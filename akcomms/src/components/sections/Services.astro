---
import site from "@/data/site.json";
import type { Service } from "@/types/site";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";

const services = site.services as Service[];
const revealClass = "transition-[opacity,transform] duration-[620ms] ease-[cubic-bezier(0.22,1,0.36,1)] [.motion-ready_&]:translate-y-[18px] [.motion-ready_&]:opacity-0 data-[visible=true]:!translate-y-0 data-[visible=true]:!opacity-100 motion-reduce:!translate-y-0 motion-reduce:!opacity-100 motion-reduce:!transition-none";
const delays = ["delay-0", "delay-75", "delay-150", "delay-200", "delay-200"];
---

<section id="services" class="relative border-y border-brand-navy/10 bg-[linear-gradient(180deg,#ffffff_0%,#f9fcfe_100%)] py-[4.25rem] sm:py-[4.5rem] xl:py-20">
  <div class="mx-auto w-[min(calc(100%_-_2.5rem),1140px)] sm:w-[min(calc(100%_-_3rem),900px)] lg:w-[min(calc(100%_-_3rem),1080px)] xl:w-[min(calc(100%_-_clamp(2rem,6vw,6rem)),1240px)] 2xl:w-[min(calc(100%_-_8rem),1320px)]">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-14">
      <div class={revealClass} data-reveal>
        <p class="m-0 mb-3 text-sm font-bold tracking-[0.06em] text-brand-cyan-dark uppercase"><span class="mr-2 text-brand-navy tabular-nums">02</span> Our services</p>
        <h2 class="m-0 max-w-[620px] text-[1.9rem] leading-[1.22] font-bold tracking-[-0.03em] text-brand-navy sm:text-[clamp(2.15rem,3.1vw,2.85rem)] sm:leading-[1.17]">Services for better connectivity, control and security.</h2>
      </div>

      <div class:list={[revealClass, "lg:pt-1", "delay-100"]} data-reveal>
        <p class="m-0 max-w-[560px] text-base leading-[1.7] text-brand-copy sm:text-[1.08rem] sm:leading-[1.8]">
          Installation, extension, relocation and repair services across the systems you depend on, delivered with practical advice and a tidy finish.
        </p>
        <a
          class="mt-6 inline-flex items-center gap-2 font-bold text-brand-cyan-dark no-underline hover:underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan"
          href={site.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsAppIcon class="h-4 w-4 shrink-0" />
          Discuss your requirements
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:mt-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-7">
      {services.map((service, index) => (
        <article class:list={["relative flex h-full flex-col rounded-sm border border-brand-navy/12 bg-white px-[1.35rem] py-[1.45rem] text-left shadow-[0_10px_28px_rgb(0_48_96/4%)] transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-[3px] hover:border-brand-cyan/35 hover:shadow-[0_18px_40px_rgb(0_48_96/10%)] sm:px-6 sm:py-6", revealClass, delays[index]]} data-reveal>
          <div class="grid h-11 w-11 place-items-center rounded-full bg-brand-cyan/8 text-brand-cyan">
            {service.key === "wifi" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5a12 12 0 0 1 16 0M7 13a7.5 7.5 0 0 1 10 0M10 16.5a3 3 0 0 1 4 0M12 20h.01" /></svg>}
            {service.key === "cctv" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 7 14-2 2 9-14 2-2-9Zm13 8 2 4M15 19h6M6 16l-2 3" /><circle cx="15.5" cy="9.5" r="2.5" /></svg>}
            {service.key === "fibre" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4v5a3 3 0 0 0 3 3h8a3 3 0 0 1 3 3v5M2 4h6M16 20h6" /><circle cx="12" cy="12" r="2" /></svg>}
            {service.key === "smart-home" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-7 9 7v9H3v-9Z" /><path d="M8 14a6 6 0 0 1 8 0M10.5 16.5a2.3 2.3 0 0 1 3 0M12 19h.01" /></svg>}
            {service.key === "equipment" && <svg class="h-[34px] w-[34px] fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M7 9h.01M11 9h.01M15 9h2M7 14h10" /></svg>}
          </div>
          <h3 class="mt-4 mb-2 text-[1.16rem] leading-[1.3] font-bold text-brand-navy sm:text-[1.24rem]">{service.title}</h3>
          <p class="m-0 max-w-[32ch] text-[0.98rem] leading-[1.72] text-brand-copy sm:text-[1rem] sm:leading-[1.78]">{service.description}</p>
          <a class="mt-5 inline-flex items-center gap-1.5 text-[0.98rem] font-bold text-brand-cyan-dark no-underline hover:underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon class="h-4 w-4 shrink-0" />
            Enquire now
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
