---
import site from "@/data/site.json";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";
---

<section id="what-we-do" class="overview-section journey-section">
  <div class="shell overview-layout">
    <div data-reveal>
      <p class="section-kicker"><span>01</span> What we do</p>
      <h2>One team for the systems that keep you connected and secure.</h2>
    </div>
    <div class="overview-copy" data-reveal style="--reveal-delay: 100ms">
      <p>
        AK Comms helps homes and businesses install, improve and repair essential connectivity and security technology.
      </p>
      <p>
        From Wi-Fi coverage and fibre connections to CCTV, smart home systems and supporting network equipment, you can discuss the complete requirement with one service provider.
      </p>
      <a class="text-link" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
        <WhatsAppIcon class="whatsapp-icon whatsapp-icon-small" />
        Discuss your requirements
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
