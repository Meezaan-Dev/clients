---
import site from "@/data/site.json";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";

const revealClass = "transition-[opacity,transform] duration-[620ms] ease-[cubic-bezier(0.22,1,0.36,1)] [.motion-ready_&]:translate-y-[18px] [.motion-ready_&]:opacity-0 data-[visible=true]:!translate-y-0 data-[visible=true]:!opacity-100 motion-reduce:!translate-y-0 motion-reduce:!opacity-100 motion-reduce:!transition-none";
---

<section id="what-we-do" class="relative bg-brand-mist py-[4.25rem] sm:py-[4.5rem] xl:py-20">
  <div class="mx-auto grid w-[min(calc(100%_-_2.5rem),1140px)] grid-cols-1 items-start gap-8 sm:w-[min(calc(100%_-_3rem),900px)] lg:w-[min(calc(100%_-_3rem),1080px)] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-14 xl:w-[min(calc(100%_-_clamp(2rem,6vw,6rem)),1240px)] 2xl:w-[min(calc(100%_-_8rem),1320px)]">
    <div class={revealClass} data-reveal>
      <p class="m-0 mb-3 text-sm font-bold tracking-[0.06em] text-brand-cyan-dark uppercase"><span class="mr-2 text-brand-navy tabular-nums">01</span> What we do</p>
      <h2 class="m-0 text-[1.9rem] leading-[1.22] font-bold tracking-[-0.03em] text-brand-navy sm:text-[clamp(2.15rem,3.1vw,2.85rem)] sm:leading-[1.17]">One team for the systems that keep you connected and secure.</h2>
    </div>
    <div class:list={[revealClass, "delay-100"]} data-reveal>
      <p class="m-0 text-base leading-[1.7] text-brand-copy sm:text-[1.12rem] sm:leading-[1.8]">
        AK Comms helps homes and businesses install, improve and repair essential connectivity and security technology.
      </p>
      <p class="mt-4 text-base leading-[1.7] text-brand-copy sm:text-[1.12rem] sm:leading-[1.8]">
        From Wi-Fi coverage and fibre connections to CCTV, smart home systems and supporting network equipment, you can discuss the complete requirement with one service provider.
      </p>
      <a
        class="mt-6 inline-flex items-center gap-2 font-bold text-brand-cyan-dark no-underline hover:underline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan"
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        <WhatsAppIcon class="h-4 w-4 shrink-0" />
        Discuss your requirements
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
