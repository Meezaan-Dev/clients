---
import site from "@/data/site.json";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";

const revealClass = "transition-[opacity,transform] duration-[620ms] ease-[cubic-bezier(0.22,1,0.36,1)] [.motion-ready_&]:translate-y-[18px] [.motion-ready_&]:opacity-0 data-[visible=true]:!translate-y-0 data-[visible=true]:!opacity-100 motion-reduce:!translate-y-0 motion-reduce:!opacity-100 motion-reduce:!transition-none";
---

<section id="top" class="relative overflow-hidden bg-brand-navy text-white">
  <div
    class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1544197150-b99a580bb7a8?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D')] bg-cover bg-[58%_center] sm:bg-center"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,rgb(0_36_84/96%)_0%,rgb(0_48_96/88%)_100%)] sm:bg-[linear-gradient(90deg,rgb(0_36_84/97%)_0%,rgb(0_48_96/91%)_42%,rgb(0_74_125/60%)_72%,rgb(0_125_181/27%)_100%)]"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-x-0 bottom-0 h-[42px] bg-linear-to-b from-transparent to-[#ecf7fb]/10" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-[560px] w-[min(calc(100%_-_2.5rem),1140px)] items-center py-16 sm:min-h-[570px] sm:w-[min(calc(100%_-_3rem),900px)] sm:py-20 lg:min-h-[560px] lg:w-[min(calc(100%_-_3rem),1080px)] lg:py-14 xl:min-h-[clamp(540px,64vh,660px)] xl:w-[min(calc(100%_-_clamp(2rem,6vw,6rem)),1240px)] xl:py-[4.25rem] 2xl:min-h-[680px] 2xl:w-[min(calc(100%_-_8rem),1320px)]">
    <div class:list={["w-full max-w-[700px] 2xl:max-w-[730px]", revealClass]} data-reveal>
      <p class="m-0 mb-3 text-sm font-bold tracking-[0.06em] text-[#a9e7fb] uppercase">Internet &amp; Communications Specialists</p>
      <h1 class="m-0 max-w-[700px] text-[clamp(1.95rem,8.7vw,2.3rem)] leading-[1.17] font-bold tracking-[-0.025em] text-white sm:text-[clamp(2.6rem,6vw,3.3rem)] sm:leading-[1.14] lg:text-[clamp(2.65rem,4.2vw,3.35rem)] xl:text-[clamp(2.65rem,3.65vw,3.5rem)]">Poor connectivity and unreliable systems should not slow you down.</h1>
      <p class="mt-6 max-w-[680px] text-base leading-[1.7] text-[#e2eaf1] sm:text-[clamp(1.05rem,0.45vw+0.95rem,1.28rem)]">
        Get practical help with Wi-Fi, fibre, CCTV, smart technology and network equipment for your home or business.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          class="inline-flex min-h-12 min-w-[170px] items-center justify-center gap-2 rounded-sm border border-transparent bg-brand-cyan px-5 py-3 text-base leading-[1.2] font-bold tracking-[0.05em] text-white uppercase no-underline transition-[background-color,transform] duration-200 hover:-translate-y-px hover:bg-brand-cyan-light focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan"
          href={site.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          Enquire on WhatsApp
          <WhatsAppIcon class="h-5 w-5 shrink-0" />
        </a>
        <a
          class="inline-flex min-h-12 items-center justify-center rounded-sm border border-transparent bg-white px-5 py-3 text-base leading-[1.2] font-bold text-brand-navy no-underline transition-[background-color,transform] duration-200 hover:-translate-y-px hover:bg-[#eaf6fb] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan"
          href={`tel:${site.phone}`}
        >
          Call {site.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
