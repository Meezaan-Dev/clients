---
import site from "@/data/site.json";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";

const revealClass = "transition-[opacity,transform] duration-[620ms] ease-[cubic-bezier(0.22,1,0.36,1)] [.motion-ready_&]:translate-y-[18px] [.motion-ready_&]:opacity-0 data-[visible=true]:!translate-y-0 data-[visible=true]:!opacity-100 motion-reduce:!translate-y-0 motion-reduce:!opacity-100 motion-reduce:!transition-none";
---

<section id="contact" class="bg-brand-navy pt-[4.5rem] pb-12 text-white sm:pt-[4.5rem] sm:pb-11 xl:pt-[5.25rem] xl:pb-[3.25rem]">
  <div class="mx-auto block w-[min(calc(100%_-_2.5rem),1140px)] sm:w-[min(calc(100%_-_3rem),900px)] lg:w-[min(calc(100%_-_3rem),1080px)] xl:w-[min(calc(100%_-_clamp(2rem,6vw,6rem)),1240px)] 2xl:w-[min(calc(100%_-_8rem),1320px)]">
    <div class={revealClass} data-reveal>
      <p class="m-0 mb-3 text-sm font-bold tracking-[0.06em] text-[#dff6fd] uppercase">Get in touch</p>
      <h2 class="mt-0 max-w-[650px] text-[1.9rem] leading-[1.22] font-bold tracking-[-0.03em] text-white sm:text-[clamp(2.15rem,3.1vw,2.8rem)] sm:leading-[1.17]">Ready to sort out your connectivity or security requirements?</h2>
      <p class="mt-4 max-w-[640px] text-base leading-[1.7] text-[#c7d7e1] sm:text-[1.1rem] sm:leading-[1.75]">Tell AK Comms what you need installed, improved, moved or repaired. Contact us by WhatsApp, phone or email.</p>
    </div>

    <div class="mt-9 grid grid-cols-1 gap-4 sm:mt-10 sm:grid-cols-3">
      <a
        class:list={["flex min-w-0 flex-col items-start rounded-sm border border-white/20 p-6 text-white no-underline transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan sm:min-h-[190px]", revealClass, "delay-75"]}
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
      >
        <WhatsAppIcon class="mb-4 h-7 w-7 shrink-0 text-[#8dddf7]" />
        <span class="text-[0.82rem] font-bold tracking-[0.06em] text-[#9fb9c9] uppercase">WhatsApp</span>
        <strong class="mt-1 text-[1.12rem] leading-[1.4] text-white">Start a chat</strong>
        <span class="mt-4 inline-flex items-center gap-2 pt-0 text-[0.92rem] font-semibold text-[#dce9f0] sm:mt-auto sm:pt-5">Send us your enquiry <span aria-hidden="true">&rarr;</span></span>
      </a>
      <a
        class:list={["flex min-w-0 flex-col items-start rounded-sm border border-white/20 p-6 text-white no-underline transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan sm:min-h-[190px]", revealClass, "delay-150"]}
        href={`tel:${site.phone}`}
        data-reveal
      >
        <svg class="mb-4 h-7 w-7 shrink-0 fill-none stroke-current stroke-[1.7] text-[#8dddf7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.5 4.6 5.1c-.7.4-1 1.2-.8 2 1.3 6.4 6.3 11.4 12.7 12.7.8.2 1.6-.1 2-.8l1.6-2.6a1.5 1.5 0 0 0-.4-2l-2.8-2.1a1.5 1.5 0 0 0-1.8 0l-1.6 1.2a13.2 13.2 0 0 1-3-3l1.2-1.6a1.5 1.5 0 0 0 0-1.8L9.2 3.9a1.5 1.5 0 0 0-2-.4Z" /></svg>
        <span class="text-[0.82rem] font-bold tracking-[0.06em] text-[#9fb9c9] uppercase">Phone</span>
        <strong class="mt-1 text-[1.12rem] leading-[1.4] text-white">{site.phoneDisplay}</strong>
        <span class="mt-4 inline-flex items-center gap-2 pt-0 text-[0.92rem] font-semibold text-[#dce9f0] sm:mt-auto sm:pt-5">Call AK Comms <span aria-hidden="true">&rarr;</span></span>
      </a>
      <a
        class:list={["flex min-w-0 flex-col items-start rounded-sm border border-white/20 p-6 text-white no-underline transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-cyan sm:min-h-[190px]", revealClass, "delay-200"]}
        href={`mailto:${site.email}`}
        data-reveal
      >
        <svg class="mb-4 h-7 w-7 shrink-0 fill-none stroke-current stroke-[1.7] text-[#8dddf7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
        <span class="text-[0.82rem] font-bold tracking-[0.06em] text-[#9fb9c9] uppercase">Email</span>
        <strong class="mt-1 [overflow-wrap:anywhere] text-[1.12rem] leading-[1.4] text-white">{site.email}</strong>
        <span class="mt-4 inline-flex items-center gap-2 pt-0 text-[0.92rem] font-semibold text-[#dce9f0] sm:mt-auto sm:pt-5">Write to us <span aria-hidden="true">&rarr;</span></span>
      </a>
    </div>
  </div>
</section>
